{
  "$defs": {
    "CompanyProfileField": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "client_eligible": {
          "title": "Client Eligible",
          "type": "boolean"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "period": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "predicate": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "section": {
          "$ref": "#/$defs/ProfileSectionCode"
        },
        "status": {
          "$ref": "#/$defs/ProfileFieldStatus"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "claim_id",
        "section",
        "predicate",
        "value",
        "status",
        "critical",
        "client_eligible"
      ],
      "title": "CompanyProfileField",
      "type": "object"
    },
    "CompanyProfileSection": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ProfileSectionCode"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/CompanyProfileField"
          },
          "title": "Fields",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ProfileSectionStatus"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "code",
        "title",
        "status"
      ],
      "title": "CompanyProfileSection",
      "type": "object"
    },
    "CompanyProfileSummary": {
      "additionalProperties": false,
      "properties": {
        "blocked_fields": {
          "minimum": 0,
          "title": "Blocked Fields",
          "type": "integer"
        },
        "client_release_ready": {
          "title": "Client Release Ready",
          "type": "boolean"
        },
        "closed_critical_gaps": {
          "maximum": 6,
          "minimum": 0,
          "title": "Closed Critical Gaps",
          "type": "integer"
        },
        "critical_gap_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Critical Gap Coverage",
          "type": "number"
        },
        "critical_gaps": {
          "default": 6,
          "maximum": 6,
          "minimum": 6,
          "title": "Critical Gaps",
          "type": "integer"
        },
        "hypothesis_fields": {
          "minimum": 0,
          "title": "Hypothesis Fields",
          "type": "integer"
        },
        "profile_gate_passed": {
          "title": "Profile Gate Passed",
          "type": "boolean"
        },
        "release_blockers": {
          "items": {
            "type": "string"
          },
          "title": "Release Blockers",
          "type": "array"
        },
        "required_sections": {
          "default": 14,
          "maximum": 14,
          "minimum": 14,
          "title": "Required Sections",
          "type": "integer"
        },
        "section_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Section Coverage",
          "type": "number"
        },
        "unresolved_conflicts": {
          "minimum": 0,
          "title": "Unresolved Conflicts",
          "type": "integer"
        },
        "verified_fields": {
          "minimum": 0,
          "title": "Verified Fields",
          "type": "integer"
        },
        "verified_sections": {
          "maximum": 14,
          "minimum": 0,
          "title": "Verified Sections",
          "type": "integer"
        }
      },
      "required": [
        "verified_sections",
        "section_coverage",
        "closed_critical_gaps",
        "critical_gap_coverage",
        "verified_fields",
        "hypothesis_fields",
        "blocked_fields",
        "unresolved_conflicts",
        "profile_gate_passed",
        "client_release_ready"
      ],
      "title": "CompanyProfileSummary",
      "type": "object"
    },
    "CriticalGapAssessment": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "closed": {
          "title": "Closed",
          "type": "boolean"
        },
        "code": {
          "$ref": "#/$defs/CriticalGapCode"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CriticalGapStatus"
        }
      },
      "required": [
        "code",
        "status",
        "closed"
      ],
      "title": "CriticalGapAssessment",
      "type": "object"
    },
    "CriticalGapCode": {
      "enum": [
        "contacts",
        "workforce",
        "financials",
        "ownership",
        "affiliations",
        "legal_events"
      ],
      "title": "CriticalGapCode",
      "type": "string"
    },
    "CriticalGapStatus": {
      "enum": [
        "closed",
        "hypothesis",
        "blocked",
        "missing"
      ],
      "title": "CriticalGapStatus",
      "type": "string"
    },
    "EvidenceTier": {
      "enum": [
        "tier_1_authority",
        "tier_2_first_party",
        "tier_3_independent",
        "tier_4_signal",
        "unassessed"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "FreshnessState": {
      "enum": [
        "current",
        "stale",
        "not_yet_valid",
        "unassessed"
      ],
      "title": "FreshnessState",
      "type": "string"
    },
    "ProfileEvidenceClaimAssessment": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/FreshnessState"
        },
        "tier": {
          "$ref": "#/$defs/EvidenceTier"
        }
      },
      "required": [
        "claim_id",
        "tier",
        "freshness"
      ],
      "title": "ProfileEvidenceClaimAssessment",
      "type": "object"
    },
    "ProfileEvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "claim_assessments": {
          "items": {
            "$ref": "#/$defs/ProfileEvidenceClaimAssessment"
          },
          "minItems": 1,
          "title": "Claim Assessments",
          "type": "array"
        },
        "document_accessed_at": {
          "format": "date-time",
          "title": "Document Accessed At",
          "type": "string"
        },
        "document_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Document Digest",
          "type": "string"
        },
        "document_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_title": {
          "title": "Document Title",
          "type": "string"
        },
        "document_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Document Url",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "quote": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "source_kind",
        "publisher",
        "document_id",
        "document_url",
        "document_title",
        "document_accessed_at",
        "document_digest",
        "quote",
        "locator",
        "evidence_digest",
        "claim_assessments"
      ],
      "title": "ProfileEvidenceItem",
      "type": "object"
    },
    "ProfileFieldStatus": {
      "enum": [
        "verified",
        "hypothesis",
        "not_found",
        "blocked"
      ],
      "title": "ProfileFieldStatus",
      "type": "string"
    },
    "ProfileSectionCode": {
      "enum": [
        "identity",
        "official_presence",
        "contacts",
        "workforce",
        "financials",
        "leadership_and_founders",
        "ownership_and_affiliations",
        "legal_events",
        "market_signals",
        "business_machine",
        "economic_signals",
        "ai_opportunity",
        "risks_gaps_conflicts",
        "evidence_appendix"
      ],
      "title": "ProfileSectionCode",
      "type": "string"
    },
    "ProfileSectionStatus": {
      "enum": [
        "verified",
        "partial",
        "missing",
        "blocked"
      ],
      "title": "ProfileSectionStatus",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "official_registry",
        "first_party",
        "licensed_provider",
        "news_media",
        "industry_catalog",
        "scientific_database",
        "social",
        "manual"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "$id": "https://aimeton.ru/schemas/sef-company-profile-v0.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "canonical_name": {
      "title": "Canonical Name",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "critical_gap_assessments": {
      "items": {
        "$ref": "#/$defs/CriticalGapAssessment"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Critical Gap Assessments",
      "type": "array"
    },
    "entity_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Entity Id",
      "type": "string"
    },
    "evidence_appendix": {
      "items": {
        "$ref": "#/$defs/ProfileEvidenceItem"
      },
      "title": "Evidence Appendix",
      "type": "array"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "mission_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Mission Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/CompanyProfileSection"
      },
      "maxItems": 14,
      "minItems": 14,
      "title": "Sections",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/CompanyProfileSummary"
    }
  },
  "required": [
    "id",
    "mission_id",
    "entity_id",
    "correlation_id",
    "as_of",
    "canonical_name",
    "sections",
    "critical_gap_assessments",
    "summary"
  ],
  "title": "CompanyProfileV1",
  "type": "object"
}
