{
  "$defs": {
    "ClaimConflictGroup": {
      "additionalProperties": false,
      "properties": {
        "accepted_claim_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Claim Id"
        },
        "claim_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "title": "Claim Ids",
          "type": "array"
        },
        "entity_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ConflictState"
        }
      },
      "required": [
        "id",
        "mission_id",
        "entity_id",
        "predicate",
        "claim_ids",
        "state"
      ],
      "title": "ClaimConflictGroup",
      "type": "object"
    },
    "ClaimLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "client_eligible": {
          "title": "Client Eligible",
          "type": "boolean"
        },
        "conflict_group_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Conflict Group Ids",
          "type": "array"
        },
        "contradicting_evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Contradicting Evidence Ids",
          "type": "array"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "latest_review_decision_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Review Decision Id"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "review_state": {
          "$ref": "#/$defs/EffectiveReviewState"
        },
        "state": {
          "$ref": "#/$defs/ClaimState"
        },
        "supporting_evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceAssessment"
          },
          "title": "Supporting Evidence",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "state",
        "critical",
        "review_state",
        "client_eligible"
      ],
      "title": "ClaimLedgerEntry",
      "type": "object"
    },
    "ClaimState": {
      "enum": [
        "candidate",
        "confirmed",
        "contradicted",
        "not_found"
      ],
      "title": "ClaimState",
      "type": "string"
    },
    "ConflictState": {
      "enum": [
        "unresolved",
        "resolved"
      ],
      "title": "ConflictState",
      "type": "string"
    },
    "EffectiveReviewState": {
      "enum": [
        "approved",
        "rejected",
        "needs_more_evidence",
        "pending"
      ],
      "title": "EffectiveReviewState",
      "type": "string"
    },
    "EvidenceAssessment": {
      "additionalProperties": false,
      "properties": {
        "accepted_for_predicate": {
          "title": "Accepted For Predicate",
          "type": "boolean"
        },
        "evidence_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "fresh_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fresh Until"
        },
        "freshness": {
          "$ref": "#/$defs/FreshnessState"
        },
        "tier": {
          "$ref": "#/$defs/EvidenceTier"
        },
        "valid_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid At"
        }
      },
      "required": [
        "evidence_id",
        "tier",
        "freshness",
        "accepted_for_predicate"
      ],
      "title": "EvidenceAssessment",
      "type": "object"
    },
    "EvidenceMetadata": {
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "fresh_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fresh Until"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/EvidenceTier"
        },
        "valid_at": {
          "format": "date-time",
          "title": "Valid At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mission_id",
        "evidence_id",
        "correlation_id",
        "tier",
        "valid_at",
        "recorded_at"
      ],
      "title": "EvidenceMetadata",
      "type": "object"
    },
    "EvidenceTier": {
      "enum": [
        "tier_1_authority",
        "tier_2_first_party",
        "tier_3_independent",
        "tier_4_signal",
        "unassessed"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "FreshnessState": {
      "enum": [
        "current",
        "stale",
        "not_yet_valid",
        "unassessed"
      ],
      "title": "FreshnessState",
      "type": "string"
    },
    "LedgerPolicy": {
      "additionalProperties": false,
      "properties": {
        "default_accepted_tiers": {
          "items": {
            "$ref": "#/$defs/EvidenceTier"
          },
          "minItems": 1,
          "title": "Default Accepted Tiers",
          "type": "array"
        },
        "default_max_age_days": {
          "default": 365,
          "maximum": 36500,
          "minimum": 0,
          "title": "Default Max Age Days",
          "type": "integer"
        },
        "predicates": {
          "items": {
            "$ref": "#/$defs/PredicateFreshnessPolicy"
          },
          "title": "Predicates",
          "type": "array"
        }
      },
      "title": "LedgerPolicy",
      "type": "object"
    },
    "LedgerRequest": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "evidence_metadata": {
          "items": {
            "$ref": "#/$defs/EvidenceMetadata"
          },
          "title": "Evidence Metadata",
          "type": "array"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/LedgerPolicy"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "mission_id",
        "as_of"
      ],
      "title": "LedgerRequest",
      "type": "object"
    },
    "LedgerSnapshot": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimLedgerEntry"
          },
          "title": "Claims",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/ClaimConflictGroup"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceAssessment"
          },
          "title": "Evidence",
          "type": "array"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/LedgerSummary"
        }
      },
      "required": [
        "mission_id",
        "correlation_id",
        "as_of",
        "summary"
      ],
      "title": "LedgerSnapshot",
      "type": "object"
    },
    "LedgerSummary": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "client_eligible_claims": {
          "minimum": 0,
          "title": "Client Eligible Claims",
          "type": "integer"
        },
        "confirmed_claims": {
          "minimum": 0,
          "title": "Confirmed Claims",
          "type": "integer"
        },
        "critical_claims": {
          "minimum": 0,
          "title": "Critical Claims",
          "type": "integer"
        },
        "critical_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Critical Coverage",
          "type": "number"
        },
        "critical_eligible_claims": {
          "minimum": 0,
          "title": "Critical Eligible Claims",
          "type": "integer"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "pending_review_claims": {
          "minimum": 0,
          "title": "Pending Review Claims",
          "type": "integer"
        },
        "stale_evidence": {
          "minimum": 0,
          "title": "Stale Evidence",
          "type": "integer"
        },
        "total_claims": {
          "minimum": 0,
          "title": "Total Claims",
          "type": "integer"
        },
        "unresolved_conflict_groups": {
          "minimum": 0,
          "title": "Unresolved Conflict Groups",
          "type": "integer"
        }
      },
      "required": [
        "mission_id",
        "as_of",
        "total_claims",
        "confirmed_claims",
        "client_eligible_claims",
        "critical_claims",
        "critical_eligible_claims",
        "critical_coverage",
        "unresolved_conflict_groups",
        "stale_evidence",
        "pending_review_claims"
      ],
      "title": "LedgerSummary",
      "type": "object"
    },
    "PredicateFreshnessPolicy": {
      "additionalProperties": false,
      "properties": {
        "accepted_tiers": {
          "items": {
            "$ref": "#/$defs/EvidenceTier"
          },
          "minItems": 1,
          "title": "Accepted Tiers",
          "type": "array"
        },
        "max_age_days": {
          "maximum": 36500,
          "minimum": 0,
          "title": "Max Age Days",
          "type": "integer"
        },
        "predicate": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        }
      },
      "required": [
        "predicate",
        "max_age_days"
      ],
      "title": "PredicateFreshnessPolicy",
      "type": "object"
    }
  },
  "$id": "https://aimeton.ru/schemas/sef-ledger-v0.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "request": {
      "$ref": "#/$defs/LedgerRequest"
    },
    "snapshot": {
      "$ref": "#/$defs/LedgerSnapshot"
    }
  },
  "required": [
    "request",
    "snapshot"
  ],
  "title": "LedgerContract",
  "type": "object"
}
