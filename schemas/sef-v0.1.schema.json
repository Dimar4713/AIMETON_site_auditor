{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "critical": {
          "default": false,
          "title": "Critical",
          "type": "boolean"
        },
        "entity_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ClaimEvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "predicate": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ClaimState"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "mission_id",
        "entity_id",
        "correlation_id",
        "predicate",
        "value",
        "state",
        "created_at"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/EvidenceRelation"
        }
      },
      "required": [
        "evidence_id",
        "relation"
      ],
      "title": "ClaimEvidenceRef",
      "type": "object"
    },
    "ClaimState": {
      "enum": [
        "candidate",
        "confirmed",
        "contradicted",
        "not_found"
      ],
      "title": "ClaimState",
      "type": "string"
    },
    "CostEvent": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "provider_call_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Call Id"
        },
        "unit_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Unit Name",
          "type": "string"
        },
        "units": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)",
              "type": "string"
            }
          ],
          "title": "Units"
        }
      },
      "required": [
        "id",
        "mission_id",
        "correlation_id",
        "currency",
        "amount",
        "units",
        "unit_name",
        "occurred_at"
      ],
      "title": "CostEvent",
      "type": "object"
    },
    "DiscoveryHint": {
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "discovered_at": {
          "format": "date-time",
          "title": "Discovered At",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "provider_call_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Provider Call Id",
          "type": "string"
        },
        "snippet": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Snippet",
          "type": "string"
        },
        "title": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mission_id",
        "provider_call_id",
        "correlation_id",
        "url",
        "title",
        "snippet",
        "discovered_at"
      ],
      "title": "DiscoveryHint",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "accessed_at": {
          "format": "date-time",
          "title": "Accessed At",
          "type": "string"
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "fetch_status": {
          "$ref": "#/$defs/DocumentFetchState"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mission_id",
        "source_id",
        "correlation_id",
        "url",
        "title",
        "accessed_at",
        "fetch_status"
      ],
      "title": "Document",
      "type": "object"
    },
    "DocumentFetchState": {
      "enum": [
        "fetched",
        "failed",
        "blocked"
      ],
      "title": "DocumentFetchState",
      "type": "string"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "canonical_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Canonical Name",
          "type": "string"
        },
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "entity_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mission_id",
        "correlation_id",
        "entity_type",
        "canonical_name"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EntityIdentifier": {
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "normalized_value": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Normalized Value",
          "type": "string"
        },
        "scheme": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Scheme",
          "type": "string"
        },
        "value": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mission_id",
        "entity_id",
        "correlation_id",
        "scheme",
        "value",
        "normalized_value"
      ],
      "title": "EntityIdentifier",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "document_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "document_quote",
            "official_record",
            "dataset_row"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "quote": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mission_id",
        "source_id",
        "document_id",
        "correlation_id",
        "evidence_type",
        "quote",
        "locator",
        "observed_at",
        "digest"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceRelation": {
      "enum": [
        "supports",
        "contradicts"
      ],
      "title": "EvidenceRelation",
      "type": "string"
    },
    "Mission": {
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "goal": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "runtime_task_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Runtime Task Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "search_plan": {
          "$ref": "#/$defs/SearchPlan"
        },
        "state": {
          "$ref": "#/$defs/MissionState"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "runtime_task_id",
        "correlation_id",
        "title",
        "goal",
        "state",
        "search_plan",
        "created_at",
        "updated_at"
      ],
      "title": "Mission",
      "type": "object"
    },
    "MissionState": {
      "enum": [
        "created",
        "running",
        "review",
        "completed",
        "blocked",
        "failed",
        "cancelled"
      ],
      "title": "MissionState",
      "type": "string"
    },
    "ProviderCall": {
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "operation": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "provider_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Provider Ref",
          "type": "string"
        },
        "request_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ProviderCallState"
        }
      },
      "required": [
        "id",
        "mission_id",
        "correlation_id",
        "provider_ref",
        "operation",
        "request_fingerprint",
        "state",
        "started_at",
        "finished_at"
      ],
      "title": "ProviderCall",
      "type": "object"
    },
    "ProviderCallState": {
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "skipped"
      ],
      "title": "ProviderCallState",
      "type": "string"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "client_facing": {
          "default": true,
          "title": "Client Facing",
          "type": "boolean"
        },
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mission_id",
        "correlation_id",
        "title",
        "claim_ids",
        "generated_at"
      ],
      "title": "Report",
      "type": "object"
    },
    "ReviewDecision": {
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/ReviewDecisionValue"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reviewer_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reviewer Ref",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_type": {
          "enum": [
            "claim",
            "evidence",
            "report"
          ],
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mission_id",
        "correlation_id",
        "target_type",
        "target_id",
        "decision",
        "reviewer_ref",
        "reason",
        "decided_at"
      ],
      "title": "ReviewDecision",
      "type": "object"
    },
    "ReviewDecisionValue": {
      "enum": [
        "approved",
        "rejected",
        "needs_more_evidence"
      ],
      "title": "ReviewDecisionValue",
      "type": "string"
    },
    "SearchPlan": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "query_count": {
          "minimum": 0,
          "title": "Query Count",
          "type": "integer"
        },
        "required_source_kinds": {
          "items": {
            "$ref": "#/$defs/SourceKind"
          },
          "title": "Required Source Kinds",
          "type": "array"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/SearchPlanState"
        }
      },
      "required": [
