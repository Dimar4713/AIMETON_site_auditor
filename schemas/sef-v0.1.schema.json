    "SearchPlanState": {
      "enum": [
        "planned",
        "running",
        "completed",
        "failed"
      ],
      "title": "SearchPlanState",
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "homepage_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Homepage Url",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "mission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mission Id",
          "type": "string"
        },
        "publisher": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "terms_ref": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Ref"
        }
      },
      "required": [
        "id",
        "mission_id",
        "correlation_id",
        "kind",
        "publisher",
        "homepage_url"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "official_registry",
        "first_party",
        "licensed_provider",
        "news_media",
        "industry_catalog",
        "scientific_database",
        "social",
        "manual"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "$id": "https://aimeton.ru/schemas/sef-v0.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Provider-neutral transport and validation envelope for SEF v0.1.",
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "cost_events": {
      "items": {
        "$ref": "#/$defs/CostEvent"
      },
      "title": "Cost Events",
      "type": "array"
    },
    "discovery_hints": {
      "items": {
        "$ref": "#/$defs/DiscoveryHint"
